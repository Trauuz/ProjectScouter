{
  "name": "project_scouter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "prebuild": "npm run validate:deployment",
    "build": "next build",
    "postbuild": "npm run validate:client-bundle",
    "prestart": "npm run validate:deployment",
    "start": "next start",
    "validate:deployment": "node --conditions=react-server --import tsx scripts/validate-production-environment.ts",
    "validate:client-bundle": "node scripts/check-client-bundle-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@perplexity-ai/perplexity_ai": "^0.38.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.3",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
