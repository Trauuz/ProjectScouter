RESEARCH_PROVIDER=tavily
RESEARCH_API_KEY=
RECOMMENDATION_PROVIDER=gemini
RECOMMENDATION_API_KEY=
RECOMMENDATION_MODEL=gemini-2.5-flash

# Supabase Auth project settings. These identify the public Auth API and are
# intentionally browser-readable; they are not database credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase transaction-pooler connection (port 6543 on Vercel).
DATABASE_URL=

# Direct connection for migrations (port 5432). A session-pooler URL also works
# when the machine running migrations cannot reach Supabase over IPv6.
DATABASE_MIGRATION_URL=

# Optional: dedicated, migrated Postgres database for repository integration tests.
TEST_DATABASE_URL=
