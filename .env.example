# Database
# For autoscaling/serverless hosting, copy Supabase Dashboard > Connect >
# Transaction pooler (port 6543). Use DATABASE_MIGRATION_URL for direct migrations.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Deployment model: transaction_pooler + serverless is the safe default.
DATABASE_CONNECTION_MODE=transaction_pooler
DATABASE_RUNTIME=serverless
# Per-instance Postgres.js pool and timeouts, in seconds where noted.
DATABASE_POOL_MAX=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_MAX_LIFETIME_SECONDS=1800
DATABASE_SHUTDOWN_TIMEOUT_SECONDS=5
# Must satisfy: pool max * max app instances <= budget - reserved connections.
DATABASE_CONNECTION_BUDGET=60
DATABASE_MAX_APP_INSTANCES=10
DATABASE_RESERVED_CONNECTIONS=10
DATABASE_SSL_MODE=require

# Supabase authentication
# Public project URL from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Public browser-safe publishable key. This is not an admin credential.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret from Supabase Dashboard > Project Settings > API Keys.
# Configure only in the deployment secret manager. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random server-only value of at least 32 characters for the retry worker.
# Configure only in the deployment secret manager; never commit the value.
ACCOUNT_DELETION_WORKER_SECRET=

# Research provider
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
# Exact provider search preset/mode, for example advanced or pro-search.
RESEARCH_PROVIDER_MODE=

# Recommendation provider
RECOMMENDATION_PROVIDER=
RECOMMENDATION_API_KEY=
RECOMMENDATION_MODEL=

# Provider usage ledger and preflight safety ceilings. Amounts use integer
# microdollars (1 USD = 1,000,000 microdollars) to avoid floating-point money.
ACCOUNT_MONTHLY_RESEARCH_LIMIT=5
RESEARCH_PROVIDER_MONTHLY_CREDIT_CEILING=900
RESEARCH_PROVIDER_CREDITS_PER_CALL=2
RECOMMENDATION_PROVIDER_DAILY_CALL_CEILING=10
PROVIDER_USAGE_WARNING_PERCENT=80
PROVIDER_DAILY_SPEND_CEILING_MICRODOLLARS=500000
PROVIDER_MONTHLY_SPEND_CEILING_MICRODOLLARS=10000000
# Copy current provider pricing from its official pricing page at deployment.
RESEARCH_PROVIDER_REQUEST_MICRODOLLARS=0
RESEARCH_PROVIDER_INPUT_MICRODOLLARS_PER_MILLION_TOKENS=0
RESEARCH_PROVIDER_OUTPUT_MICRODOLLARS_PER_MILLION_TOKENS=0
RESEARCH_PROVIDER_MICRODOLLARS_PER_CREDIT=0
RECOMMENDATION_PROVIDER_REQUEST_MICRODOLLARS=0
RECOMMENDATION_PROVIDER_INPUT_MICRODOLLARS_PER_MILLION_TOKENS=0
RECOMMENDATION_PROVIDER_OUTPUT_MICRODOLLARS_PER_MILLION_TOKENS=0
RECOMMENDATION_PROVIDER_MICRODOLLARS_PER_CREDIT=0
